---
import { Picture } from 'astro:assets';
import { projects } from './content';
import { getResponsiveImageWidths } from '../../utils/responsive-image-widths';

const [featured, secondary] = projects;
const cardImageSizes = '(max-width: 1440px) calc((100vw - 192px) / 2), 624px';
---

<section class="work" id="work">
  <div class="page-container work-inner desktop-only">
    <header class="work-header">
      <h2>Recent projects</h2>
      <p>A selection of recent projects I have worked on.</p>
    </header>

    <div class="work-grid-desktop">
      <article class="project-card-featured">
        <Picture
          src={featured.image}
          alt={featured.imageAlt}
          width={featured.image.width}
          height={featured.image.height}
          widths={getResponsiveImageWidths(featured.image.width)}
          sizes={cardImageSizes}
          formats={['avif', 'webp']}
          quality={95}
          loading="lazy"
          decoding="async"
        />
        <div class="project-caption project-caption-featured">
          <div class="project-title-row">
            <h3>{featured.title}</h3>
            <img class="project-logo-unops" src="/unops-data.svg" alt="UNOPS Data logo" width="223" height="26" />
          </div>
          <p>{featured.summary}</p>
          <a class="project-detail-link" href="/projects/unops-data-portal/">Read project details</a>
        </div>
      </article>

      <article class="project-card-featured">
        <Picture
          src={secondary.image}
          alt={secondary.imageAlt}
          width={secondary.image.width}
          height={secondary.image.height}
          widths={getResponsiveImageWidths(secondary.image.width)}
          sizes={cardImageSizes}
          formats={['avif', 'webp']}
          quality={95}
          loading="lazy"
          decoding="async"
        />
        <div class="project-caption project-caption-featured">
          <div class="project-title-row">
            <h3>{secondary.title}</h3>
            <img class="project-logo-aarsleff" src="/aarsleff-logo-white.svg" alt="Aarsleff logo" width="60" height="30" />
          </div>
          <p>{secondary.summary}</p>
          <a class="project-detail-link" href="/projects/pipe-overview/">Read project details</a>
        </div>
      </article>
    </div>
  </div>

  <div class="work-mobile mobile-only">
    <h2>Recent projects</h2>
    <div class="mobile-work-list">
      <article class="mobile-work-card mobile-work-unops">
        <div class="mobile-work-content">
          <div class="project-title-row">
            <h3>{featured.title}</h3>
            <img class="project-logo-unops" src="/unops-data.svg" alt="UNOPS Data logo" width="223" height="26" />
          </div>
          <p>{featured.summary}</p>
          <a class="project-detail-link" href="/projects/unops-data-portal/">Read project details</a>
        </div>
      </article>

      <article class="mobile-work-card mobile-work-aarsleff">
        <div class="mobile-work-content">
          <div class="project-title-row">
            <h3>{secondary.title}</h3>
            <img class="project-logo-aarsleff" src="/aarsleff-logo-white.svg" alt="Aarsleff logo" width="60" height="30" />
          </div>
          <p>{secondary.summary}</p>
          <a class="project-detail-link" href="/projects/pipe-overview/">Read project details</a>
        </div>
      </article>

    </div>
  </div>
</section>
