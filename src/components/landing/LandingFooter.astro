---
import { navItems, socialItems } from './content';
---

<footer class="site-footer">
  <div class="desktop-only footer-desktop page-container">
    <section class="footer-identity">
      <h2>C. Bloch Thomsen</h2>
      <p>
        Quality work, dependable delivery, and frontend systems built to
        last.
      </p>
    </section>

    <div class="footer-links-wrap">
      <section>
        <h3>Navigation</h3>
        <ul>
          {navItems.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </section>

      <section>
        <h3>Connect</h3>
        <ul>
          {socialItems.filter((item) => item.label !== 'GitHub').map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </section>
    </div>
  </div>

  <div class="mobile-only footer-mobile">
    <h2>C. Bloch Thomsen</h2>
    <p>
      Quality work, dependable delivery, and frontend systems built to last.
    </p>

    <div class="social-pills">
      {socialItems.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
    </div>

    <div class="footer-links-wrap">
      <section>
        <h3>Navigation</h3>
        <ul>
          {navItems.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </section>

      <section>
        <h3>Connect</h3>
        <ul>
          {socialItems.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </section>
    </div>
  </div>
</footer>
